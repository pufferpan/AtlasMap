<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>dfmap-gui</AssemblyName>
    <RootNamespace>DfmapGui</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
  </PropertyGroup>

  <ItemGroup>
    <!-- The GUI is a front end for the same code the CLI runs; nothing is duplicated. -->
    <ProjectReference Include="..\dfmap\dfmap.csproj" />
  </ItemGroup>

  <!-- The native codec DLLs sit next to the CLI binary and must travel with the GUI too. -->
  <ItemGroup>
    <None Include="..\dfmap\Detex.dll" CopyToOutputDirectory="PreserveNewest" Link="Detex.dll" />
    <None Include="..\dfmap\zlib-ng2.dll" CopyToOutputDirectory="PreserveNewest" Link="zlib-ng2.dll" />
    <None Include="..\dfmap\oodle-data-shared.dll" CopyToOutputDirectory="PreserveNewest" Link="oodle-data-shared.dll" />
    <None Include="..\dfmap\dfmap.json" CopyToOutputDirectory="PreserveNewest" Link="dfmap.json" />
  </ItemGroup>

</Project>
